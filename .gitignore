# Build output, wherever it is built: every Cargo target folder (native/,
# each prototype, any crate built on its own), the frontend bundle, the
# WebAssembly package, and TypeScript's incremental build records.
target/
dist
*.tsbuildinfo
# Installed tools and packages.
node_modules
tools
# Fuzzing: the corpus grows on each run and crash files are triaged by
# hand; an input that found a fault is kept in native/fuzz/regressions/.
native/fuzz/corpus
native/fuzz/artifacts
native/fuzz/coverage
